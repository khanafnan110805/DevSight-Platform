# ─────────────────────────────────────────────────────────
# Dockerfile.server — DevSight API Server (Node.js + Express)
# ─────────────────────────────────────────────────────────

# ── Development target ───────────────────────────────────
FROM node:20-alpine AS development

WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json ./
RUN npm ci

# Source mounted as volume at runtime
EXPOSE 4000

CMD ["npm", "run", "dev"]


# ── Build stage ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


# ── Production target ─────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

EXPOSE 4000

CMD ["node", "dist/index.js"]
