# ─────────────────────────────────────────────────────────
# Dockerfile.client — DevSight Frontend (React + Vite)
# ─────────────────────────────────────────────────────────

# ── Development target ───────────────────────────────────
FROM node:20-alpine AS development

WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json ./
RUN npm ci

# Source is mounted as a volume at runtime; do not COPY here
EXPOSE 3000

# File-system polling for cross-platform HMR (needed on Windows Docker Desktop)
ENV CHOKIDAR_USEPOLLING=true

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]


# ── Build stage (used for CI and production simulation) ──
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_GITHUB_CLIENT_ID
ARG VITE_APP_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GITHUB_CLIENT_ID=$VITE_GITHUB_CLIENT_ID
ENV VITE_APP_URL=$VITE_APP_URL

RUN npm run build


# ── Production target (nginx static serving) ─────────────
FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
