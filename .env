# DevSight Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# =============================================================================
# GitHub OAuth Application
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:4000/api/auth/callback
# =============================================================================

GITHUB_CLIENT_ID=Ov23li8DvZaucVWp6UCS
GITHUB_CLIENT_SECRET=fbe8d7901b8136ba7019c8a0bf07022f4a7c2a07

# =============================================================================
# Session Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

SESSION_SECRET=11e12defecc5f1818280c1c1aad8639c648d08b3a1c73d2c5b8c3c51d754fa26

# =============================================================================
# Client-Side Variables (VITE_ prefix = bundled into browser)
# =============================================================================

VITE_API_URL=http://localhost:4000
VITE_GITHUB_CLIENT_ID=Ov23li8DvZaucVWp6UCS
VITE_APP_URL=http://localhost:3000

# =============================================================================
# Feature Flags (set to "true" to enable)
# =============================================================================

VITE_FEATURE_PRIVATE_REPOS=false
VITE_FEATURE_AI_INSIGHTS=false
VITE_FEATURE_LEADERBOARDS=false

# =============================================================================
# Server Configuration
# =============================================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# =============================================================================
# Optional: Analytics & Monitoring (leave empty to disable)
# =============================================================================

# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
