# DevSight Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# =============================================================================
# GitHub OAuth Application
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:4000/api/auth/callback
# =============================================================================

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# =============================================================================
# Session Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# =============================================================================
# Client-Side Variables (VITE_ prefix = bundled into browser)
# =============================================================================

VITE_API_URL=http://localhost:4000
VITE_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
VITE_APP_URL=http://localhost:3000

# =============================================================================
# Feature Flags (set to "true" to enable)
# =============================================================================

VITE_FEATURE_PRIVATE_REPOS=false
VITE_FEATURE_AI_INSIGHTS=false
VITE_FEATURE_LEADERBOARDS=false

# =============================================================================
# Server Configuration
# =============================================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# =============================================================================
# Optional: Analytics & Monitoring (leave empty to disable)
# =============================================================================

# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
